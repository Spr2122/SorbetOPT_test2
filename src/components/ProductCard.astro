---
import type { Product } from '../data/products';
const { product } = Astro.props as { product: Product };
---
<article class="product-card">
  <a class="product-image" href={`/catalog/${product.slug}/`} aria-label={`Подробнее: ${product.name}`}>
    <img src={product.image} alt={product.name} loading="lazy" width="700" height="520" />
    <span class="product-price-badge" aria-hidden="true">{product.price}</span>
  </a>
  <div class="product-body">
    <h3><a href={`/catalog/${product.slug}/`}>{product.shortName}</a></h3>
    <dl class="product-meta">
      <div><dt>Фракция</dt><dd>{product.fraction}</dd></div>
      <div><dt>Упаковка</dt><dd>{product.packaging}</dd></div>
    </dl>
    <div class="product-bottom"><strong>{product.price}</strong><span>{product.minimum}</span></div>
    <a class="text-link card-cta" href={`/catalog/${product.slug}/`}>Подробнее <span aria-hidden="true">→</span></a>
  </div>
</article>
