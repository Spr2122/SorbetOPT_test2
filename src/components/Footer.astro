---
import { CONTACT_CHANNELS } from '../data/site';
import { withBase } from '../utils/paths';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand footer-brand" href={withBase('/')} aria-label="СорбентОпт — главная">
          <svg class="brand-mark" viewBox="0 0 80 66" aria-hidden="true"><path d="M2 59 35 9l17 24 8-12 18 38H2Z"/><path d="m20 59 21-32 15 22-7 10H20Z" class="light"/><path d="m42 28 7-11 10 15-7 10-10-14Z" class="dark"/></svg>
          <span><strong>СорбентОпт</strong><small>Природные минералы и сорбенты</small></span>
        </a>
        <p class="footer-note">Оптовые поставки глауконитовой продукции по России. Подбор фракции, объёма и условий доставки под задачу клиента.</p>
      </div>
      <nav class="footer-nav" aria-label="Навигация в подвале">
        <a href={withBase('/#products')}>Продукция</a>
        <a href={withBase('/#applications')}>Применение</a>
        <a href={withBase('/#advantages')}>Характеристики</a>
        <a href={withBase('/#documents')}>Документы</a>
        <a href={withBase('/#delivery')}>Доставка</a>
        <a href={withBase('/#contacts')}>Контакты</a>
      </nav>
      <div class="footer-contact">
        {CONTACT_CHANNELS.map((channel) => (
          <a href={channel.url} target="_blank" rel="noopener">{channel.label}: {channel.value}</a>
        ))}
        <span>Россия</span>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 СорбентОпт</span>
      <span><a href={withBase('/privacy/')}>Политика обработки данных</a> · Информация о цене и наличии уточняется при оформлении заявки.</span>
    </div>
  </div>
</footer>
