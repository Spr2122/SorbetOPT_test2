---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths';
---
<BaseLayout title="Страница не найдена | СорбентОпт" description="Запрошенная страница не найдена." canonical="/404/" noindex>
  <Header />
  <main id="main-content" class="section"><div class="container narrow"><span class="eyebrow">Ошибка 404</span><h1>Страница не найдена</h1><p>Возможно, адрес изменился. Вернитесь в каталог или на главную страницу.</p><a class="button button-primary" href={withBase('/')}>На главную</a> <a class="button" href={withBase('/catalog/')}>Каталог</a></div></main>
  <Footer />
</BaseLayout>
